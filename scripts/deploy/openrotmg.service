[Unit]
Description=Open RotMG game server
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
User=openrotmg
Group=openrotmg
LoadCredential=discord-link-token:/etc/openrotmg/discord-link-token
Environment=DISCORD_LINK_TOKEN_FILE=%d/discord-link-token
Environment=RUST_BACKTRACE=1
EnvironmentFile=-/etc/openrotmg/bot-dialogue.env
EnvironmentFile=-/etc/openrotmg/discord-oauth.env
ExecStart=/opt/openrotmg/server/openrotmg --config /etc/openrotmg/config.json
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=5
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/openrotmg

[Install]
WantedBy=multi-user.target
